{
  "name": "jbpmunimap",
  "version": "1.0.0",
  "description": "muni map by james b pollack",
  "main": "devServer.js",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.10",
    "protobufjs": "^8.6.4",
    "supertest": "^7.1.4"
  },
  "scripts": {
    "start": "node devServer.js",
    "dev": "nodemon devServer.js",
    "test": "jest && jest --config jest.config.browser.js",
    "test:server": "jest",
    "test:browser": "jest --config jest.config.browser.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage && jest --config jest.config.browser.js --coverage"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imgntn/prettymuni.git"
  },
  "author": "james b. pollack",
