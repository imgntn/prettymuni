# Coolify / Nixpacks
NIXPACKS_NODE_VERSION=22
NODE_ENV=development
PORT=3333

# 511 Transit API. Server-side only; never place this key in docs/client files.
TRANSIT_511_API_KEY=change-me
TRANSIT_OPERATOR_ID=SF
TRANSIT_AGENCY_ID=SF
TRANSIT_PROXY_TIMEOUT_MS=30000

# Use the production origin in Coolify, or * for local development.
CORS_ORIGIN=*
